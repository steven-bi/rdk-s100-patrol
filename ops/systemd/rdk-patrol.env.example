# 复制为 /etc/rdk-patrol.env 后，执行：
#   sudo chown root:<服务用户组> /etc/rdk-patrol.env
#   sudo chmod 640 /etc/rdk-patrol.env
#
# 不要把真实密钥提交、打包或粘贴到日志中。
MINIMAX_API_KEY=

# 必须与相机 ROS 2 节点使用的域一致。
ROS_DOMAIN_ID=0

# 仅当板端 ROS 2 明确要求时再启用，例如 rmw_fastrtps_cpp。
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp

PYTHONUNBUFFERED=1
