[Unit]
Description=RDK S100 unified patrol detection
Documentation=file:/opt/rdk-patrol/current/README.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/rdk-patrol
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=sunrise
Group=sunrise
WorkingDirectory=/opt/rdk-patrol/current
EnvironmentFile=-/etc/rdk-patrol.env
Environment=PYTHONUNBUFFERED=1
Environment=RDK_PATROL_PREFIX=/opt/rdk-patrol
Environment=RDK_PATROL_DATA_DIR=/var/lib/rdk-patrol
Environment=RDK_PATROL_CONFIG=/opt/rdk-patrol/current/configs/system.yaml
Environment=ROS_LOG_DIR=/var/lib/rdk-patrol/logs/ros
ExecStart=/opt/rdk-patrol/current/scripts/rdk/run-service.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGINT
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/rdk-patrol

[Install]
WantedBy=multi-user.target
